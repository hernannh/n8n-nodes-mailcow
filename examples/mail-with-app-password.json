{
 "name": "mailcow: app password for IMAP and SMTP",
 "nodes": [
  {
   "parameters": {},
   "id": "a1",
   "name": "Run once",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "resource": "appPassword",
    "operation": "create",
    "mailbox": "support@example.com",
    "appName": "n8n",
    "protocols": [
     "imap_access",
     "smtp_access"
    ]
   },
   "id": "a2",
   "name": "Create app password",
   "type": "n8n-nodes-mailcow.mailcow",
   "typeVersion": 1,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "content": "## 1. Run once\nCreates an app password for the mailbox, limited to IMAP and SMTP. Copy `generated_password` from the output: it is shown only once.\n\nThen create an **IMAP** credential (port 993, SSL) and an **SMTP** credential (port 465 SSL, or 587 STARTTLS) with the mailbox address as user and that password.",
    "height": 260,
    "width": 420
   },
   "id": "n1",
   "name": "Note setup",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -40,
    -300
   ]
  },
  {
   "parameters": {
    "mailbox": "INBOX",
    "postProcessAction": "nothing",
    "options": {}
   },
   "id": "b1",
   "name": "New mail in support@",
   "type": "n8n-nodes-base.emailReadImap",
   "typeVersion": 2.2,
   "position": [
    0,
    400
   ]
  },
  {
   "parameters": {
    "fromEmail": "support@example.com",
    "toEmail": "admin@example.com",
    "subject": "=New support mail: {{ $json.subject }}",
    "emailFormat": "text",
    "text": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\n\n{{ $json.textPlain }}",
    "options": {}
   },
   "id": "b2",
   "name": "Notify admin",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
   "position": [
    220,
    400
   ]
  },
  {
   "parameters": {
    "content": "## 2. Activate\nWatches the INBOX of support@ over IMAP and sends a copy to admin@ over SMTP, both with the app password credentials.\n\nSend to an address outside this mailbox, or the notification triggers the workflow again.",
    "height": 240,
    "width": 420
   },
   "id": "n2",
   "name": "Note workflow",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -40,
    120
   ]
  }
 ],
