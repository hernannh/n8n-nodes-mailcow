   "parameters": {
    "jsCode": "// Summary without personal data: item count, error and field names per node.\nconst names = [\"Version\", \"Containers\", \"Vmail\", \"Domains\", \"Domain get\", \"Mailboxes\", \"Mailboxes by domain\", \"Aliases\", \"Quarantine\", \"Queue\", \"Postfix log\", \"DKIM\", \"Mailbox missing\", \"Write must fail\"];\nreturn names.map((node) => {\n  try {\n    const items = $(node).all();\n    const first = items[0]?.json ?? {};\n    const real = items.filter((i) => Object.keys(i.json).length > 0 && !i.json.error);\n    return { json: {\n      node,\n      items: real.length,\n      error: first.error ?? null,\n      version: node === 'Version' ? first.version : undefined,\n      fields: Object.keys(first).slice(0, 10).join(', '),\n    } };\n  } catch (e) {\n    return { json: { node, notRun: e.message } };\n  }\n});"
   },
