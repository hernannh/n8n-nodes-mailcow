{
  "name": "n8n-nodes-mailcow",
  "version": "0.1.0",
  "description": "n8n community nodes for mailcow: manage domains, mailboxes, aliases, app passwords, quarantine, mail queue, DKIM and logs, with a polling trigger.",
  "keywords": [
    "n8n-community-node-package",
    "mailcow",
    "email",
    "mail-server",
    "postfix",
    "dovecot",
    "self-hosted"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hernannh/n8n-nodes-mailcow",
  "author": {
    "name": "Hernan Herrera",
    "email": "hernannh@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hernannh/n8n-nodes-mailcow.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons && node tools/verify-build.mjs",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MailcowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Mailcow/Mailcow.node.js",
      "dist/nodes/MailcowTrigger/MailcowTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/hernannh/n8n-nodes-mailcow/issues"
  }
}
