  {
   "parameters": {
    "jsCode": "// Summary without secrets: generated passwords and DKIM keys are never copied.\nconst names = [\"Domain create\", \"Domain update\", \"Mailbox create\", \"Mailbox update\", \"Mailbox get\", \"Alias create\", \"Aliases\", \"Alias update\", \"Alias get\", \"App password create\", \"App passwords\", \"DKIM get (auto)\", \"DKIM create must fail\", \"DKIM delete (auto)\", \"DKIM create\", \"App password delete\", \"Alias delete\", \"Mailbox delete\", \"DKIM delete\", \"Domain delete\", \"Domain gone\"];\nconst pick = (j) => ({\n  type: j.type, msg: j.msg, error: j.error,\n  name: j.name, quota: j.quota, rl: j.rl, active: j.active, tags: j.tags,\n  description: j.description, public_comment: j.public_comment, sogo_visible: j.sogo_visible,\n  app_name: j.app_name, protocols: j.protocols, dkim_selector: j.dkim_selector, length: j.length,\n  generated_password: j.generated_password ? `set (${j.generated_password.length} chars)` : undefined,\n});\nreturn names.map((node) => {\n  try {\n    const items = $(node).all().map((i) => i.json).filter((j) => Object.keys(j).length);\n    const shown = node === 'Aliases' ? items.filter((j) => String(j.address).endsWith('@n8n-test.invalid')) : items;\n    return { json: { node, items: items.length, out: JSON.stringify(shown.slice(0, 3).map(pick)) } };\n  } catch (e) {\n    return { json: { node, notRun: e.message } };\n  }\n});"
   },
   "id": "sum",
   "name": "Summary",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    5060,
    0
   ]
  }
